# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-side only — never ship to mobile
SUPABASE_ANON_KEY=your-anon-key

# ── Quran.Foundation (backend only) ───────────────────────────────────────────
# These credentials are used by @quranjs/api (server SDK) to obtain OAuth2
# client-credentials tokens. They must NEVER be sent to the mobile app.
# Mobile calls our backend; our backend calls Quran.Foundation.
QURAN_FOUNDATION_CLIENT_ID=
QURAN_FOUNDATION_CLIENT_SECRET=

# SDK default mushaf ID (1 = QCF V2, the only supported layout for MVP).
QURAN_FOUNDATION_DEFAULT_MUSHAF_ID=1

# Optional: override SDK base URLs for prelive/staging environments.
# Leave blank to use the SDK defaults (https://apis.quran.foundation).
# QURAN_FOUNDATION_CONTENT_BASE_URL=https://prelive-apis.quran.foundation/content
# QURAN_FOUNDATION_OAUTH_BASE_URL=https://prelive-oauth2.quran.foundation

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
