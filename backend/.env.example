# ── Supabase ──────────────────────────────────────────────────────────────────
# URL must be the project base only — no /rest/v1/ suffix (the client adds it).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-side only — never ship to mobile
SUPABASE_ANON_KEY=your-anon-key

# ── Quran.Foundation (backend only) ───────────────────────────────────────────
# These credentials are used by @quranjs/api (server SDK) to obtain OAuth2
# client-credentials tokens. They must NEVER be sent to the mobile app.
# Mobile calls our backend; our backend calls Quran.Foundation.
#
# Switch between prelive and production by changing QURAN_FOUNDATION_ENV.
# Each environment has its own OAuth2 endpoint and its own client credentials.
# Content API base URL (https://apis.quran.foundation) is the same for both.
#
#   prelive    → OAuth2: https://prelive-oauth2.quran.foundation
#   production → OAuth2: https://oauth2.quran.foundation

QURAN_FOUNDATION_ENV=prelive

QURAN_FOUNDATION_PRELIVE_CLIENT_ID=your-prelive-client-id
QURAN_FOUNDATION_PRELIVE_CLIENT_SECRET=your-prelive-client-secret

QURAN_FOUNDATION_PROD_CLIENT_ID=your-prod-client-id
QURAN_FOUNDATION_PROD_CLIENT_SECRET=your-prod-client-secret

# SDK default mushaf ID (1 = QCF V2, the only supported layout for MVP).
QURAN_FOUNDATION_DEFAULT_MUSHAF_ID=1

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
