# Backend API base URL (include /api suffix)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api

# Where Supabase redirects after email confirmation.
# Must match a URL in Auth > URL Configuration > Redirect URLs in the Supabase dashboard.
# For phone testing, use your laptop's LAN IP: http://192.168.x.x:3000/auth/callback
EXPO_PUBLIC_AUTH_REDIRECT_URL=http://localhost:3000/auth/callback

# Supabase project credentials — copy from Supabase dashboard > Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
