# ── Supabase ──────────────────────────────────────────────────────────────────
# URL must be the project base only — no /rest/v1/ suffix (the client adds it).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-side only — never ship to mobile
SUPABASE_ANON_KEY=your-anon-key

# ── Supabase direct DB connection (for running migrations) ────────────────────
# Found in Supabase Dashboard → Settings → Database → Connection string → URI
# Format: postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
# Only needed when running: node database/run-migrations.mjs
DATABASE_URL=

# ── Quran.Foundation (backend only) ───────────────────────────────────────────
# These credentials are used to obtain OAuth2 client-credentials tokens.
# They must NEVER be sent to the mobile app.
# Mobile calls our backend; our backend calls Quran.Foundation.
#
# Switch between prelive and production by changing QURAN_FOUNDATION_ENV.
# Each environment has its own OAuth2 endpoint and its own client credentials.
#
#   prelive    → OAuth2: https://prelive-oauth2.quran.foundation
#   production → OAuth2: https://oauth2.quran.foundation (default for real API calls)
#
# IMPORTANT: The content API (apis.quran.foundation) only accepts tokens issued
# by the production OAuth2 server. Use QURAN_FOUNDATION_ENV=production for real
# content API calls. Prelive credentials are useful only for testing token exchange.

QURAN_FOUNDATION_ENV=production

QURAN_FOUNDATION_PRELIVE_CLIENT_ID=your-prelive-client-id
QURAN_FOUNDATION_PRELIVE_CLIENT_SECRET=your-prelive-client-secret

QURAN_FOUNDATION_PROD_CLIENT_ID=your-prod-client-id
QURAN_FOUNDATION_PROD_CLIENT_SECRET=your-prod-client-secret

# SDK default mushaf ID (1 = QCF V2, the only supported layout for MVP).
QURAN_FOUNDATION_DEFAULT_MUSHAF_ID=1

# Optional URL overrides — leave blank to use defaults derived from QURAN_FOUNDATION_ENV.
# Set QURAN_FOUNDATION_CONTENT_BASE_URL if Quran.Foundation provides a separate
# prelive content API URL that accepts prelive-issued tokens.
QURAN_FOUNDATION_CONTENT_BASE_URL=
QURAN_FOUNDATION_OAUTH_BASE_URL=

# ── Storage ───────────────────────────────────────────────────────────────────
# Controls whether the server auto-creates Supabase Storage buckets on startup.
#
# Required buckets:
#   student-recordings   (private, audio only, 50 MB max)
#   teacher-voice-notes  (private, audio only, 20 MB max)
#
# local/dev:   leave unset — defaults to true when NODE_ENV != production
# production:  set to true ONLY for the initial deploy to create the buckets;
#              unset (or set to false) for all subsequent deploys once buckets exist
AUTO_CREATE_STORAGE_BUCKETS=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
